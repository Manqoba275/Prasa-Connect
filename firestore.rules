rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function validRoute(data) {
      return data.keys().hasOnly(['origin', 'destination', 'updatedAt'])
        && data.keys().hasAll(['origin', 'destination', 'updatedAt'])
        && data.origin is string && data.origin.size() >= 1 && data.origin.size() <= 120
        && data.destination is string && data.destination.size() >= 1 && data.destination.size() <= 120
        && data.updatedAt is timestamp;
    }

    match /users/{uid}/saved_routes/{routeId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && validRoute(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
